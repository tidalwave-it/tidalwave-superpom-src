        <!--====================================================================================================================================================

        Javadoc is generated from delomboked sources, otherwise members generated by Lombok (e.g. constructors) are  not seen and javadoc documents members that
        don't exist (such as a public default constructor).

        Delombok can't process module-info.java (it doesn't apply Lombok to a named module), so sources are delomboked without it, and module-info.java is
         copied verbatim (it doesn't contain any Lombok stuff).

        The delomboked copy is only used by javadoc and needs two fixes:
        + delombok reformats comments, turning the opening and closing lines of the banner comments into lines made of asterisks only, that javadoc would
          render as text: they are made empty;
        + the @SuppressFBWarnings added by Lombok is removed, since it's not relevant for documentation and some modules don't read the SpotBugs annotations
          module;
        + the canEqual() method generated by @EqualsAndHashCode gets a comment, since it can't be documented in the sources.

        Steps are bound to initialize and generate-sources since javadoc:javadoc forks the lifecycle up to the latter.

        The site uses the delomboked sources too: since its Javadoc report (javadoc-no-fork) doesn't fork the lifecycle, they must have been created by a
        previous build with this profile active, as it happens for the other inputs of the site.

        =====================================================================================================================================================-->
        <profile>
            <id>it.tidalwave-javadoc-delombok-v1</id>
            <activation>
                <file>
                    <exists>${project.basedir}/src/main/java</exists>
                </file>
            </activation>
            <properties>
                <tft.delombok.sources>${project.build.directory}/delombok-src</tft.delombok.sources>
                <tft.delombok.directory>${project.build.directory}/delombok</tft.delombok.directory>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-resources-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>prepare-delombok-sources</id>
                                <phase>initialize</phase>
                                <goals>
                                    <goal>copy-resources</goal>
                                </goals>
                                <configuration>
                                    <outputDirectory>${tft.delombok.sources}</outputDirectory>
                                    <resources>
                                        <resource>
                                            <directory>${project.build.sourceDirectory}</directory>
                                            <excludes>
                                                <exclude>module-info.java</exclude>
                                            </excludes>
                                        </resource>
                                    </resources>
                                </configuration>
                            </execution>
                            <execution>
                                <id>copy-module-info-to-delombok</id>
                                <phase>initialize</phase>
                                <goals>
                                    <goal>copy-resources</goal>
                                </goals>
                                <configuration>
                                    <outputDirectory>${tft.delombok.directory}</outputDirectory>
                                    <resources>
                                        <resource>
                                            <directory>${project.build.sourceDirectory}</directory>
                                            <includes>
                                                <include>module-info.java</include>
                                            </includes>
                                        </resource>
                                    </resources>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <dependencies>
                            <!-- Only to have it resolved into the local repository before the execution. -->
                            <dependency>
                                <groupId>org.projectlombok</groupId>
                                <artifactId>lombok</artifactId>
                                <version>${tft.lombok.version}</version>
                            </dependency>
                        </dependencies>
                        <executions>
                            <execution>
                                <id>delombok</id>
                                <phase>initialize</phase>
                                <goals>
                                    <goal>exec</goal>
                                </goals>
                                <configuration>
                                    <executable>${java.home}/bin/java</executable>
                                    <classpathScope>compile</classpathScope>
                                    <arguments>
                                        <argument>-jar</argument>
                                        <argument>${settings.localRepository}/org/projectlombok/lombok/${tft.lombok.version}/lombok-${tft.lombok.version}.jar</argument>
                                        <argument>delombok</argument>
                                        <argument>--quiet</argument>
                                        <argument>--encoding=${project.build.sourceEncoding}</argument>
                                        <argument>${tft.delombok.sources}</argument>
                                        <argument>--target=${tft.delombok.directory}</argument>
                                        <argument>--classpath</argument>
                                        <classpath />
                                    </arguments>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-antrun-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>fix-delomboked-sources</id>
                                <phase>generate-sources</phase>
                                <goals>
                                    <goal>run</goal>
                                </goals>
                                <configuration>
                                    <target>
                                        <replaceregexp flags="gm" encoding="${project.build.sourceEncoding}">
                                            <regexp pattern="^([ \t]*)\* \*{10,}[ \t]*$" />
                                            <substitution expression="\1*" />
                                            <fileset dir="${tft.delombok.directory}" includes="**/*.java" />
                                        </replaceregexp>
                                        <replaceregexp flags="g" encoding="${project.build.sourceEncoding}">
                                            <regexp pattern="@edu\.umd\.cs\.findbugs\.annotations\.SuppressFBWarnings\(justification = &quot;generated code&quot;\)" />
                                            <substitution expression="" />
                                            <fileset dir="${tft.delombok.directory}" includes="**/*.java" />
                                        </replaceregexp>
                                        <replaceregexp flags="gm" encoding="${project.build.sourceEncoding}">
                                            <regexp pattern="^([ \t]*)(@java\.lang\.SuppressWarnings\(&quot;all&quot;\)[ \t]*\n(?:[ \t]*(?:@[^\n]*)?\n)*?[ \t]*protected boolean canEqual\(final java\.lang\.Object other\))" />
                                            <substitution expression="\1/**&#xA;\1 * {@return whether {@code other} can be equal to this object}. Generated by Lombok as part of the {@code equals()}&#xA;\1 * contract of a class that can be subclassed.&#xA;\1 * @param other     the other object&#xA;\1 */&#xA;\1\2" />
                                            <fileset dir="${tft.delombok.directory}" includes="**/*.java" />
                                        </replaceregexp>
                                    </target>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-javadoc-plugin</artifactId>
                        <configuration>
                            <sourcepath>${tft.delombok.directory}</sourcepath>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
            <!-- The site ignores the configuration in build/plugins. The sourcepath is set in the 'default' report set only (the one running javadoc-no-fork
                 in it.tidalwave-site-v1), since it would also apply to the test reports. No <reports> here: when merged, javadoc-no-fork would be
                 declared twice and Maven would warn about it. -->
            <reporting>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-javadoc-plugin</artifactId>
                        <reportSets>
                            <reportSet>
                                <id>default</id>
                                <configuration>
                                    <sourcepath>${tft.delombok.directory}</sourcepath>
                                </configuration>
                            </reportSet>
                        </reportSets>
                    </plugin>
                </plugins>
            </reporting>
        </profile>
    </profiles>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
                <!-- Configuration must be replicated in reporting section -->
                <configuration>
                    <tags>
                        <tag>
                            <name>it.tidalwave.javadoc.stable</name>
                            <placement>t</placement>
                            <head>Status: stable API</head>
                        </tag>
                        <tag>
                            <name>it.tidalwave.javadoc.draft</name>
                            <placement>t</placement>
                            <head>Status: draft API</head>
                        </tag>
                        <tag>
                            <name>it.tidalwave.javadoc.experimental</name>
                            <placement>t</placement>
                            <head>Status: experimental API</head>
                        </tag>
                        <tag>
                            <name>stereotype</name>
                            <placement>t</placement>
                            <head>Stereotype:</head>
                        </tag>
                        <tag>
                            <name>hidden</name>
                            <placement>t</placement>
                            <head />
                        </tag>
                    </tags>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <properties>
                        <property>
                            <name>listener</name>
                            <value>${tft.test.listeners}</value>
                        </property>
                    </properties>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <execution>
                        <id>enforce-maven</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <dependencyConvergence />
                            </rules>
                        </configuration>
                    </execution>
                    <execution>
                        <id>enforce-banned-dependencies</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <bannedDependencies>
                                    <excludes>
                                        <exclude>commons-logging:commons-logging</exclude>
                                        <exclude>com.kenai.nbpwr:org-slf4j-jdk14</exclude>
                                        <exclude>com.google.code.findbugs:annotations</exclude>
                                        <!-- We use static weaving only, but now is required anyway:
                                         See https://stackoverflow.com/questions/77791637/is-aspectjweaver-dependency-mandatory-for-spring-boot
                                         -->
                                        <!-- exclude>org.aspectj:aspectjweaver</exclude -->
                                    </excludes>
                                </bannedDependencies>
                            </rules>
                            <fail>true</fail>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-site-plugin</artifactId>
                <dependencies>
                    <dependency>
                        <groupId>org.apache.maven.skins</groupId>
                        <artifactId>maven-fluido-skin</artifactId>
                        <version>${tft.maven-fluido-skin.version}</version>
                        <scope>compile</scope>
                    </dependency>
                </dependencies>
            </plugin>

            <plugin>
                <groupId>com.mycila</groupId>
                <artifactId>license-maven-plugin</artifactId>
                <dependencies>
                    <dependency>
                        <groupId>it.tidalwave.thesefoolishthings</groupId>
                        <artifactId>superpom-config</artifactId>
                        <version>${tft.superpom.config.version}</version>
                    </dependency>
                </dependencies>
                <configuration>
                    <licenseSets>
                        <licenseSet>
                            <header>${tft.header}</header>
                            <excludes>
                                <exclude>**/README.md</exclude>
                                <!-- Keep *.xml -->
                                <exclude>src/main/resources/**/*.txt</exclude>
                                <exclude>src/main/resources/**/*.properties</exclude>
                                <exclude>src/test/resources/**/*.txt</exclude>
                                <exclude>src/test/resources/**/*.properties</exclude>
                                <exclude>**/.maven-env</exclude>
                                <exclude>**/.maven-local-env</exclude>
                                <exclude>**/lombok.config</exclude>
                                <exclude>**/*.form</exclude>
                                <exclude>**/*-profile</exclude>
                                <exclude>**/.idea/**/*</exclude>
                                <exclude>bitbucket-pipelines.yml</exclude>
                                <exclude>LICENSE.*</exclude>
                                <exclude>.lgtm.yml</exclude>
                            </excludes>
                        </licenseSet>
                    </licenseSets>
                    <defaultProperties>
                        <scm.repo.readonly.url>${scm.repo.readonly.url}</scm.repo.readonly.url>
                        <tidalwave.slogan>${tidalwave.slogan}</tidalwave.slogan>
                        <tidalwave.project.url>${tidalwave.project.url}</tidalwave.project.url>
                        <tidalwave.github.readonly.url>${tidalwave.github.readonly.url}</tidalwave.github.readonly.url>
                        <tft.header.year>${tft.header.year}</tft.header.year>
                        <project.organization.name>${project.organization.name}</project.organization.name>
                        <project.organization.url>${project.organization.url}</project.organization.url>
                    </defaultProperties>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>jaxb2-maven-plugin</artifactId>
                <!-- TODO: version 3.0.0 is not found on Maven Central, so we're patching 2.5.0 to work with Jakarta JAXB. -->
                <dependencies>
                    <dependency>
                        <groupId>org.glassfish.jaxb</groupId>
                        <artifactId>jaxb-xjc</artifactId>
                        <version>${tft.jaxb.version}</version>
                    </dependency>
                    <dependency>
                        <groupId>jakarta.xml.bind</groupId>
                        <artifactId>jakarta.xml.bind-api</artifactId>
                        <version>${tft.jaxb.version}</version>
                    </dependency>
                    <dependency>
                        <groupId>com.sun.xml.bind</groupId>
                        <artifactId>jaxb-impl</artifactId>
                        <version>${tft.jaxb.version}</version>
                    </dependency>
                </dependencies>
            </plugin>
        </plugins>
    </build>

    <reporting>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
                <version>${tft.maven-javadoc-plugin.version}</version>
                <!-- Configuration must be replicated from build section -->
                <configuration>
                    <tags>
                        <tag>
                            <name>it.tidalwave.javadoc.stable</name>
                            <placement>t</placement>
                            <head>Status: stable API</head>
                        </tag>
                        <tag>
                            <name>it.tidalwave.javadoc.draft</name>
                            <placement>t</placement>
                            <head>Status: draft API</head>
                        </tag>
                        <tag>
                            <name>it.tidalwave.javadoc.experimental</name>
                            <placement>t</placement>
                            <head>Status: experimental API</head>
                        </tag>
                        <tag>
                            <name>stereotype</name>
                            <placement>t</placement>
                            <head>Stereotype:</head>
                        </tag>
                        <tag>
                            <name>hidden</name>
                            <placement>t</placement>
                            <head />
                        </tag>
                    </tags>
                </configuration>
            </plugin>
        </plugins>
    </reporting>

</project>
